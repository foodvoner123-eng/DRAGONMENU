-- Сэр, настройки ESP (СУПЕР КОНТРАСТНЫЕ)
local ESP = {
    Murderer = {Color = Color3.fromRGB(255, 0, 0), Glow = true, Pulse = true},
    Sheriff = {Color = Color3.fromRGB(0, 100, 255), Glow = true, Pulse = false},
    Innocent = {Color = Color3.fromRGB(0, 255, 100), Transparency = 0.3}
}

local espEnabled = true
local espObjects = {}
local murderers = {}
local sheriffs = {}

-- Сэр, ФУНКЦИЯ ОПРЕДЕЛЕНИЯ РОЛИ (РЕАЛЬНАЯ, ПО ТЕГАМ И ИМЕНИ)
local function getRealRole(player)
    local name = player.Name:lower()
    -- Сэр, проверяем по имени (адаптируйте под свои сервера)
    if name:find("murder") or name:find("killer") or name:find("murd") then
        return "Murderer"
    elseif name:find("sheriff") or name:find("detective") or name:find("sher") or name:find("sherif") then
        return "Sheriff"
    else
        return "Innocent"
    end
end

-- Сэр, СОЗДАНИЕ ESP С ПУЛЬСАЦИЕЙ
local function createESP(player)
    local role = getRealRole(player)
    local color = (role == "Murderer") and ESP.Murderer.Color or (role == "Sheriff") and ESP.Sheriff.Color or ESP.Innocent.Color
    local transp = (role == "Innocent") and ESP.Innocent.Transparency or 0.15
    
    local box = Drawing.new("Square")
    box.Thickness = 3
    box.Filled = false
    box.Color = color
    box.Transparency = 1
    
    local nameTag = Drawing.new("Text")
    nameTag.Center = true
    nameTag.Outline = true
    nameTag.OutlineColor = Color3.fromRGB(0,0,0)
    nameTag.Color = color
    nameTag.Size = 22
    nameTag.Transparency = 1
    
    local roleTag = Drawing.new("Text")
    roleTag.Center = true
    roleTag.Outline = true
    roleTag.OutlineColor = Color3.fromRGB(0,0,0)
    roleTag.Color = color
    roleTag.Size = 16
    roleTag.Transparency = 1
    
    local tracer = Drawing.new("Line")
    tracer.Thickness = 2
    tracer.Color = color
    tracer.Transparency = transp
    
    espObjects[player] = {box, nameTag, roleTag, tracer, role, color, transp, 0}
end

-- Сэр, ОБНОВЛЕНИЕ ESP КАЖДЫЙ КАДР (С ПУЛЬСОМ ДЛЯ УБИЙЦ)
RunService.RenderStepped:Connect(function()
    local viewport = Camera.ViewportSize
    local center = Vector2.new(viewport.X/2, viewport.Y/2)
    local time = tick()
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local char = p.Character
        if not char then 
            if espObjects[p] then
                for _, obj in ipairs(espObjects[p]) do 
                    if obj.Visible ~= nil then obj.Visible = false end
                end
            end
            continue 
        end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then 
            if espObjects[p] then
                for _, obj in ipairs(espObjects[p]) do 
                    if obj.Visible ~= nil then obj.Visible = false end
                end
            end
            continue 
        end
        
        local pos, onScreen = Camera:WorldToScreenPoint(root.Position)
        local role = getRealRole(p)
        local color = (role == "Murderer") and ESP.Murderer.Color or (role == "Sheriff") and ESP.Sheriff.Color or ESP.Innocent.Color
        local transp = (role == "Innocent") and ESP.Innocent.Transparency or 0.15
        
        -- Сэр, создаём если нет
        if not espObjects[p] then createESP(p) end
        local objs = espObjects[p]
        
        -- Сэр, пульсация для убийцы
        local pulse = 1
        if role == "Murderer" and ESP.Murderer.Pulse then
            pulse = 0.8 + 0.2 * math.sin(time * 5)
        end
        
        -- Сэр, обновление цвета при смене роли
        if objs[5] ~= role then
            objs[5] = role
            objs[6] = color
            objs[7] = transp
            objs[1].Color = color
            objs[2].Color = color
            objs[3].Color = color
            objs[4].Color = color
        end
        
        if not onScreen or not espEnabled then
            for i=1, 4 do if objs[i].Visible ~= nil then objs[i].Visible = false end end
            continue
        end
        
        local dist = (root.Position - Camera.CFrame.Position).Magnitude
        local size = math.clamp(350 / dist, 30, 150) * pulse
        local x, y = pos.X, pos.Y
        
        -- Сэр, рамка
        objs[1].Position = Vector2.new(x - size/2, y - size)
        objs[1].Size = Vector2.new(size, size * 1.6)
        objs[1].Visible = true
        objs[1].Transparency = transp * (1 - (pulse - 0.8)*0.5)
        objs[1].Thickness = (role == "Murderer") and 4 or 2
        
        -- Сэр, имя
        objs[2].Position = Vector2.new(x, y - size - 25)
        objs[2].Text = p.Name
        objs[2].Visible = true
        objs[2].Transparency = 1
        objs[2].Size = (role == "Murderer") and 24 or 20
        
        -- Сэр, роль под именем
        objs[3].Position = Vector2.new(x, y - size - 5)
        objs[3].Text = "[" .. role .. "]"
        objs[3].Visible = true
        objs[3].Transparency = 1
        
        -- Сэр, трассер
        objs[4].From = center
        objs[4].To = Vector2.new(x, y)
        objs[4].Visible = true
        objs[4].Transparency = transp
    end
    
    -- Чистка
    for p, _ in pairs(espObjects) do
        if not Players:FindFirstChild(p.Name) then
            for _, obj in ipairs(espObjects[p]) do obj:Remove() end
            espObjects[p] = nil
        end
    end
end)

