-- Сэр, ФУНКЦИЯ ПРИМЕНЕНИЯ НАСТРОЕК
-- ==========================================================
local function applySettings()
    -- Сэр, гравитация
    workspace.Gravity = settings.gravity
    
    -- Сэр, обновление персонажа
    local char = LocalPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid then
            -- Сэр, скорость
            humanoid.WalkSpeed = settings.speed
            -- Сэр, сила прыжка
            humanoid.JumpPower = settings.superJump
            -- Сэр, бесконечные прыжки
            humanoid.MaxJumpHeight = settings.infiniteJumps and 1000 or 7
        end
        -- Сэр, полёт (через BodyVelocity)
        if settings.fly then
            if not char:FindFirstChild("FlyVelocity") then
                local bv = Instance.new("BodyVelocity")
                bv.Name = "FlyVelocity"
                bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
                bv.Velocity = Vector3.new(0, 0, 0)
                bv.Parent = hrp or char
            end
        else
            if char:FindFirstChild("FlyVelocity") then
                char.FlyVelocity:Destroy()
            end
        end
    end
end

